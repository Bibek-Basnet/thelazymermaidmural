# Copy this file to .env.local and fill in the values.
# Find them at https://sanity.io/manage after creating your Sanity project
# (or run `npx sanity init --env .env.local` to create the project and
# write the first two values automatically).

NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# API token with Editor permissions — only needed to run `npm run seed`.
# Create one at sanity.io/manage → your project → API → Tokens.
SANITY_API_WRITE_TOKEN=""

# Any random string. Set the same value on the Sanity webhook
# (sanity.io/manage → API → Webhooks) for instant publishing;
# without it, edits go live within 60 seconds anyway.
SANITY_REVALIDATE_SECRET=""

# Contact form emails (resend.com → API Keys).
RESEND_API_KEY=""
# Where contact form enquiries are delivered.
CONTACT_EMAIL_TO="Sarah.thelazymermaid@gmail.com"
# Optional sender. Defaults to onboarding@resend.dev, which Resend only
# delivers to the account owner's own email — verify a domain at
# resend.com/domains, then use e.g.
# "The Lazy Mermaid Murals <website@thelazymermaidmurals.com>".
CONTACT_EMAIL_FROM=""
